{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joplin RS",
  "version": "0.2.0",
  "identifier": "app.joplinrs.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Joplin RS",
        "width": 1320,
        "height": 840,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
